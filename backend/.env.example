# Copy this file to  backend/.env  and edit. The backend reads it automatically.

# Your MySQL server. Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# If the password has special characters, URL-encode them:  @ -> %40   # -> %23   : -> %3A   / -> %2F   % -> %25   space -> %20
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/impart?charset=utf8mb4

# fake model (default) | http = real engine
# MODEL_MODE=http
# MODEL_URL=http://localhost:8001/api/evaluate
# MODEL_REQUEST_FIELD=cr_text
# API_KEY=
